# gemini — настоящая модель; mock — офлайн-заглушки (тесты/демо без квоты, бюджет $0)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

DATABASE_URL=sqlite:///./aqylmed.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/aqylmed

# обязательно поменять: длинная случайная строка (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me

# RAG: порог косинусного сходства (US-05). Тюнится на 20 тестовых вопросах QA.
# RAG_MIN_SIMILARITY=0.75
